{
  "name": "house-of-cinders",
  "private": true,
  "version": "0.9.0",
  "scripts": {
    "build": "python3 scripts/build.py",
    "test": "luajit tests/run.lua",
    "serve": "python3 -m http.server 8000 --directory dist/web",
    "test:browser": "luajit tests/fixtures.lua && node scripts/browser-test.cjs",
    "format": "stylua main.lua conf.lua devtools.lua src tests",
    "format:check": "stylua --check main.lua conf.lua devtools.lua src tests"
  },
  "devDependencies": {
    "@johnnymorganz/stylua-bin": "2.6.0",
    "love.js": "11.4.1",
    "playwright": "1.56.1"
  }
}
